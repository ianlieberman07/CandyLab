---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Notice from '../components/Notice.astro';
import { getStandalonePages } from '../utils/pages';
import galleryData from '../../content/gallery.json';
import petsData from '../../content/pets.json';

export const getStaticPaths = (async () => {
  const pages = await getStandalonePages();
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);

const body = page.body?.trim() ?? '';

// A page can name a photo set to print under its text. Keeps the gallery and
// pets pages as ordinary, client-editable pages rather than two more bespoke
// templates.
const SETS = { gallery: galleryData.items, pets: petsData.items } as const;
const photos = page.data.gallery ? SETS[page.data.gallery] : null;

// Vite resolves these at build time; each file is then run through Astro's
// image pipeline like any other asset.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/pages/images/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const resolve = (path: string) => files[path.replace('./', '../../content/pages/')]?.default;
---

<Base title={page.data.title} description={page.data.lede ?? `${page.data.title} — CANDY Lab, UCLA.`}>
  <PageHeader
    eyebrow={page.data.eyebrow}
    title={page.data.title}
    lede={page.data.lede}
    image={page.data.hero}
    imageAlt={page.data.heroAlt}
    imageFocus={page.data.heroFocus}
  />

  {/* On a page with no header photo the header type is centred, so the body
      follows the same axis: the notice and the prose column sit centred rather
      than hugging the left with an empty right half. Text inside the prose
      stays left-aligned — centred paragraphs are hard to read — it is the
      COLUMN that centres. */}
  <div class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
    {
      page.data.needsReview && (
        <div class="mb-12 flex justify-center">
          <Notice title="This page is still a placeholder">
            <p>
              The lab's current site says only “Coming Soon” here, so there is nothing to carry
              over yet. Write the page in the admin and untick “Mark as incomplete” — until then
              it is deliberately left as it stands rather than filled with invented text.
            </p>
          </Notice>
        </div>
      )
    }

    {
      body && (
        <div class="reveal prose-lab mx-auto max-w-(--container-prose)">
          <Content />
        </div>
      )
    }

    {
      photos && (
        <ul
          class:list={[
            'grid grid-cols-2 gap-6 md:grid-cols-3 xl:grid-cols-4',
            body ? 'mt-16' : '',
          ]}
        >
          {photos.map((photo, i) => {
            const src = resolve(photo.image);
            if (!src) return null;
            return (
              <li class="reveal" data-reveal-delay={String((i % 4) * 60)}>
                <figure>
                  <div class="overflow-hidden border border-ink/10 bg-paper-sunk">
                    {/* Where a caption is printed beside the photo it carries
                        the meaning, and alt="" is correct — alt text would make
                        a screen reader announce the same sentence twice. Where
                        there is NO caption the description is genuinely
                        missing; that is flagged in DOCS/QUESTIONS.md and is
                        editable in the admin.

                        Comment kept outside the tag — see PageHeader.astro. */}
                    <Image
                      src={src}
                      alt={photo.alt || ''}
                      widths={[320, 560, 860]}
                      sizes="(min-width: 1280px) 23vw, (min-width: 768px) 31vw, 46vw"
                      loading={i < 4 ? 'eager' : 'lazy'}
                      class="h-full w-full object-cover"
                    />
                  </div>
                  {photo.caption && (
                    <figcaption class="mt-3 text-[0.88rem] leading-relaxed text-ink-muted">
                      {photo.caption}
                    </figcaption>
                  )}
                </figure>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</Base>

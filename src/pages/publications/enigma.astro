---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

// The original site's Publications > ENIGMA sub-page, rebuilt with real links.
// The source page listed titles and journals with no links of any kind; every
// DOI here was resolved against the registration databases, and anything that
// could not be resolved gets a search fallback rather than a guessed URL.
const papers = (await getCollection('enigmaPapers')).sort(
  (a, b) => b.data.year - a.data.year || b.data.id - a.data.id
);

const total = papers.length;
const withDoi = papers.filter((p) => p.data.doi).length;

const scholar = (title: string) =>
  `https://scholar.google.com/scholar?q=${encodeURIComponent(title)}`;
---

<Base
  title="ENIGMA"
  description={`${total} publications from Dr. Ho's work with the ENIGMA consortium — global meta-analyses of brain structure in depression and stress.`}
>
  <PageHeader
    eyebrow="Publications"
    title="ENIGMA Consortium"
    lede="Dr. Ho collaborates with researchers around the globe through the ENIGMA consortium to identify the effects of depression and stress on brain morphometry and to examine sex differences and age-related effects on the brain."
  />

  <section class="mx-auto max-w-[104rem] px-(--spacing-gutter) pb-(--spacing-section)">
    <p class="mx-auto max-w-(--container-prose) text-center text-[0.95rem] text-ink-muted">
      <a href="/publications" class="link-rule">← All publications</a>
    </p>

    <ol class="mx-auto mt-10 max-w-[74rem]">
      {
        papers.map((paper) => {
          const d = paper.data;
          return (
            <li class="paper-item -mx-4 border-b border-ink/10 px-4 py-7 first:border-t">
              <div class="flex flex-col gap-2 sm:flex-row sm:gap-7">
                <span class="meta shrink-0 pt-1 text-ink-muted sm:w-14">{d.year}</span>
                <div class="flex-1">
                  <h2 class="font-display text-[1.2rem] leading-snug text-ink">{d.title}</h2>
                  {d.journal && (
                    <p class="mt-1 text-[0.92rem] italic leading-relaxed text-ink-muted">
                      {d.journal}
                    </p>
                  )}
                  <p class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[0.85rem]">
                    {d.doi && (
                      <a
                        href={d.doi}
                        rel="noopener"
                        class="text-signal underline-offset-4 hover:text-signal-deep hover:underline"
                      >
                        {d.openAccess && !d.free ? (
                          <>
                            <span class="oa-dot mr-1.5 align-middle" aria-hidden="true" />
                            Read it free ↗
                          </>
                        ) : (
                          'Publisher ↗'
                        )}
                      </a>
                    )}
                    {d.free && (
                      <a
                        href={d.free}
                        rel="noopener"
                        class="text-signal underline-offset-4 hover:text-signal-deep hover:underline"
                      >
                        <span class="oa-dot mr-1.5 align-middle" aria-hidden="true" />
                        Read it free ↗
                      </a>
                    )}
                    {!d.doi && (
                      <a
                        href={scholar(d.title)}
                        rel="noopener"
                        target="_blank"
                        class="text-ink-muted underline-offset-4 hover:text-signal hover:underline"
                      >
                        Search for this paper ↗
                      </a>
                    )}
                  </p>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>

    <p class="mt-10 text-center text-[0.9rem] text-ink-muted">
      {withDoi} of {total} entries verified against the DOI registry.
    </p>
  </section>
</Base>

<style>
  .paper-item {
    transition: background-color 0.4s var(--ease-out-soft);
  }
  .paper-item:hover {
    background-color: rgb(255 255 255 / 0.55);
  }
</style>

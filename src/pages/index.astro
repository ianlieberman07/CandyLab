---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { getHeader } from '../utils/headers';
import { splitWords } from '../utils/splitWords';
import galleryData from '../../content/gallery.json';
import dividerImage from '../../content/pages/images/covers/home-divider.jpg';

const hero = getHeader('home');

// A strip of lab-life photographs above the footer, linking through to the
// gallery. Taken from the end of the list — the newest photographs — and
// deliberately skipping the ones already used as page headers, so no
// photograph on this page is one the reader has just seen at the top of
// another.
const HEADER_PHOTOS = new Set([
  'gallery-01', 'gallery-05', 'gallery-07', 'gallery-09',
  'gallery-11', 'gallery-12', 'gallery-25', 'gallery-30',
]);
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/pages/images/gallery/*.jpg',
  { eager: true }
);
const strip = galleryData.items
  .filter((item) => !HEADER_PHOTOS.has(item.image.split('/').pop()!.replace('.jpg', '')))
  .slice(0, 5)
  .map((item) => ({
    src: files[item.image.replace('./', '../../content/pages/')]?.default,
    caption: item.caption,
  }))
  .filter((item) => item.src);

const studies = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);

const news = (await getCollection('news'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The lab overview is a page in /content/pages, printed here rather than given
// a URL of its own — so the copy exists at exactly one address and she edits it
// in exactly one place.
const overview = await getEntry('pages', 'lab-overview');
const { Content: Overview } = overview ? await render(overview) : { Content: null };

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={site.labNameShort}
  description={`The ${site.labName} at UCLA, directed by ${site.director}. How adversity and stress shape the adolescent brain, and what that means for depression.`}
  transparentHeader
>
  {/* ── First screen ──────────────────────────────────────────
      A white marble brain centred on the page's own black, with the type set
      quietly along the bottom — the same composition as the SAN Lab hero the
      client pointed to.

      The photograph needs no edge treatment at all: `mix-blend-lighten` takes
      the per-channel maximum against the painted ground, so every pixel darker
      than the page's black clamps to exactly the page's black and the frame
      cannot show. Any dark-field image dropped in through the admin gets the
      same seamlessness for free.

      Scroll-grow entrance, the client's brief: the brain starts small on load
      and grows as you scroll, and the page only proceeds once it is full size.
      Done as a scroll RUNWAY, not scroll-jacking — the section is 240svh tall
      and its inner viewport is sticky, so the first 140svh of ordinary
      scrolling plays the growth (a CSS scroll-driven animation on the
      compositor) while the screen stays put. No wheel events are intercepted;
      the scrollbar stays honest; assistive tech sees a normal document.
      Engines without scroll timelines, and anyone with reduced motion set,
      get the static full-size hero. */}
  <section class="hero relative">
    <div class="hero-viewport relative flex min-h-svh flex-col justify-end overflow-hidden">
      {
        hero.image && (
          <div class="absolute inset-0 bg-paper" aria-hidden="true">
            <Image
              src={hero.image}
              alt=""
              widths={[828, 1440, 2160, Math.min(hero.image.width, 2912)]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              class="hero-media-img h-full w-full object-contain object-center p-[4svh] pb-[26svh] mix-blend-lighten"
            />
          </div>
        )
      }

      {/* One quiet scrim, bottom only: it seats the type without dulling the
          sculpture above it. The top needs none — the header floats over the
          image's own black. */}
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-paper via-transparent to-transparent"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative mx-auto w-full max-w-[104rem] px-(--spacing-gutter) pb-[clamp(1.5rem,4vh,3rem)] pt-28"
      >
        <p class="reveal text-eyebrow font-medium uppercase text-signal">
          {site.department} · {site.institution}
        </p>

        <h1
          class="reveal-words mt-5 max-w-[24ch] font-display text-hero text-ink"
          data-reveal-delay="90"
          set:html={splitWords('Cognition, Affect, and Neurodevelopment in Youth')}
        />

        {/* The rule draws itself in once the name has landed, tying the name
            to the row of practicalities beneath it. */}
        <div class="reveal-rule mt-7 h-px w-full bg-ink/15" data-reveal-delay="420" aria-hidden="true">
        </div>

        <div
          class="reveal flex flex-col gap-5 pt-6 md:flex-row md:items-end md:justify-between"
          data-reveal-delay="500"
        >
          <p class="text-lede text-ink-dim">
            Directed by <span class="text-ink">{site.director}</span>
          </p>

          <div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-[0.95rem]">
            <a href={`mailto:${site.contact.email}`} class="link-rule">{site.contact.email}</a>
            <a href="/participate" class="link-rule">Take part in a study</a>
            <a href="/research" class="link-rule">Our research</a>
          </div>
        </div>
      </div>

      {/* The photograph carries the meaning, so it is described here rather
          than left as decoration. Not on the <img>: that is aria-hidden because
          the picture is the section's background, and a background does not
          announce itself before the heading. */}
      <p class="sr-only">{hero.alt}</p>
    </div>
  </section>

  {/* ── About ───────────────────────────────────────────────── */}
  {
    Overview && (
      <section class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
        <div class="grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-20">
          <h2 class="reveal font-display text-title text-ink lg:sticky lg:top-32 lg:self-start">
            About the lab
          </h2>
          <div class="reveal prose-lab max-w-(--container-prose)" data-reveal-delay="120">
            <Overview />
          </div>
        </div>
      </section>
    )
  }

  {/* ── Interlude ───────────────────────────────────────────────
      A full-width dark band between About and the studies — the licensed
      Shutterstock photograph of open hands offering a constellation-brain.
      The client asked for "sexy black" and this is where it lives: dark as
      punctuation on a light site, exactly like the Publications plate.

      The photograph's edge tone (#02131b, uniform on all four edges) IS the
      site's ground colour — --color-paper was adopted from it — so image,
      band and page are one continuous black with no seam anywhere. */}
  <section class="reveal-media bg-paper" data-reveal-delay="120">
    <figure class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-10 md:py-14">
      <Image
        src={dividerImage}
        alt="Two open hands beneath a brain drawn in points of light, offering it upward."
        widths={[640, 960, 1440]}
        sizes="(min-width: 1024px) 44rem, 92vw"
        loading="lazy"
        class="mx-auto h-auto max-h-[72svh] w-auto max-w-full"
      />
    </figure>
  </section>

  {/* ── Studies ─────────────────────────────────────────────── */}
  <section class="border-y border-ink/10 bg-paper-raised">
    <div class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="reveal font-display text-title text-ink">Our studies</h2>
        <a href="/research" class="reveal link-rule text-[0.95rem]" data-reveal-delay="80">
          All research →
        </a>
      </div>

      <ul class="mt-12">
        {
          studies.map((study, i) => (
            <li class="reveal" data-reveal-delay={String(60 + i * 45)}>
              <a
                href={`/research/${study.id}`}
                class="index-row -mx-4 flex flex-col gap-2 border-t border-ink/10 px-4 py-7 transition-colors duration-500 last:border-b sm:flex-row sm:items-baseline sm:gap-8"
              >
                <span class="meta shrink-0 text-ink-faint sm:w-10">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flex-1">
                  <span class="block font-display text-[1.35rem] leading-snug text-ink">
                    {study.data.title}
                    {study.data.status && (
                      <span class="ml-3 inline-block translate-y-[-0.15em] border border-signal/40 px-2 py-0.5 align-middle text-[0.62rem] font-medium uppercase tracking-[0.12em] text-signal">
                        {study.data.status}
                      </span>
                    )}
                  </span>
                  <span class="mt-1.5 block max-w-[60ch] text-[0.95rem] leading-relaxed text-ink-muted">
                    {study.data.summary}
                  </span>
                </span>
                <span class="shrink-0 text-signal" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── News ────────────────────────────────────────────────── */}
  {
    news.length > 0 && (
      <section class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="reveal font-display text-title text-ink">Lab news</h2>
          <a href="/news" class="reveal link-rule text-[0.95rem]" data-reveal-delay="80">
            All news →
          </a>
        </div>

        <ul class="mt-10 grid gap-px border border-ink/10 bg-ink/10 md:grid-cols-3">
          {news.map((item, i) => (
            <li class="reveal bg-paper-raised p-7" data-reveal-delay={String(60 + i * 70)}>
              <time class="meta text-ink-faint" datetime={item.data.date.toISOString().slice(0, 10)}>
                {dateFmt.format(item.data.date)}
              </time>
              <h3 class="mt-3 font-display text-[1.15rem] leading-snug text-ink">
                <a href={`/news/${item.id}`} class="link-rule">
                  {item.data.title}
                </a>
              </h3>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── Life in the lab ─────────────────────────────────────────
      Deliberately the lab's own photographs rather than stock: conferences,
      first posters, socials. None of these appears as a header elsewhere, so
      nothing here is a picture the reader has just scrolled past. */}
  {
    strip.length > 0 && (
      <section class="border-t border-ink/10 bg-paper-raised">
        <div class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="reveal font-display text-title text-ink">Life in the lab</h2>
            <a href="/lab-gallery" class="reveal link-rule text-[0.95rem]" data-reveal-delay="80">
              The whole gallery →
            </a>
          </div>

          {/* Scrolls sideways on a phone rather than shrinking five photographs
              into thumbnails nobody can make anyone out in. The container
              scrolls, not the page. */}
          <ul
            class="mt-10 -mx-(--spacing-gutter) flex snap-x snap-mandatory gap-5 overflow-x-auto px-(--spacing-gutter) pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0"
          >
            {strip.map((photo, i) => (
              <li class="reveal w-64 shrink-0 snap-start lg:w-auto" data-reveal-delay={String(i * 70)}>
                <figure>
                  <div class="aspect-[4/3] overflow-hidden border border-ink/10 bg-paper-sunk">
                    <Image
                      src={photo.src!}
                      alt=""
                      widths={[280, 480, 720]}
                      sizes="(min-width: 1024px) 19vw, 16rem"
                      loading="lazy"
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <figcaption class="mt-3 text-[0.82rem] leading-snug text-ink-muted">
                    {photo.caption}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* The hero sits on the page's own black — the blend clamps the photograph's
     near-black to it, so there is no colour to keep in sync. */
  .hero {
    background-color: var(--color-hero-ground);
  }

  /* The growth anchors just above the image's centre, where the sculpture
     sits inside its bottom-padded frame, so the brain inflates in place. */
  .hero-media-img {
    transform-origin: 50% 44%;
  }

  /* ── Scroll-grow entrance ─────────────────────────────────
     Only where scroll timelines exist AND motion is welcome: the section
     becomes a 240svh runway whose inner viewport is sticky, and the image
     scales 0.3 → 1 across the first 140svh of scroll — which is exactly when
     the sticky releases, so full size and "the page moves on" coincide.

     Two things make it feel smooth rather than mechanical. The travel is
     long — 140svh of scroll for one gesture's worth of growth, so no single
     wheel tick jumps the scale — and the curve is an ease-in-out, so the
     growth gathers speed gently and settles gently instead of tracking the
     scroll linearly. The image is object-contain, so the compositor rescales
     a viewport-sized bitmap, not an oversized cover crop.

     Compositor-only (transform), no JS, no wheel interception. Everyone else
     gets the static hero: the section stays one viewport tall and the image
     sits at full scale. */
  @supports (animation-timeline: scroll(root)) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        height: 240svh;
      }
      .hero-viewport {
        position: sticky;
        top: 0;
        height: 100svh;
        min-height: 0;
      }
      .hero-media-img {
        animation: hero-grow var(--ease-in-out-soft) both;
        animation-timeline: scroll(root);
        animation-range: 0 140svh;
        will-change: transform;
      }
    }
  }

  @keyframes hero-grow {
    from {
      transform: scale(0.3);
    }
    to {
      transform: scale(1);
    }
  }
</style>

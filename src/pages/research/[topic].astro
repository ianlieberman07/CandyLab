---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Notice from '../../components/Notice.astro';

export const getStaticPaths = (async () => {
  const studies = await getCollection('research');
  return studies.map((study) => ({ params: { topic: study.id }, props: { study } }));
}) satisfies GetStaticPaths;

const { study } = Astro.props;
const { Content } = await render(study);

const all = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);
const index = all.findIndex((s) => s.id === study.id);
const next = all[(index + 1) % all.length];
---

<Base title={study.data.title} description={study.data.summary}>
  <PageHeader
    eyebrow={study.data.status ? `Research · ${study.data.status}` : 'Research'}
    title={study.data.title}
    image={study.data.hero}
    imageAlt={study.data.heroAlt}
  />

  <article class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
    {
      study.data.needsReview && (
        <div class="mb-12">
          <Notice title="Marked as incomplete">
            <p>
              This page is flagged for review in the admin. Untick “Mark as incomplete” once the
              text is final.
            </p>
          </Notice>
        </div>
      )
    }

    <div class="reveal prose-lab max-w-(--container-prose)">
      <Content />
    </div>
  </article>

  {
    next && next.id !== study.id && (
      <nav class="border-t border-ink/10 bg-paper-raised" aria-label="Next study">
        <a
          href={`/research/${next.id}`}
          class="index-row mx-auto flex max-w-[104rem] flex-col gap-2 px-(--spacing-gutter) py-12 transition-colors duration-500 sm:flex-row sm:items-center sm:justify-between"
        >
          <span>
            <span class="text-eyebrow font-medium uppercase text-ink-muted">Next study</span>
            <span class="mt-2 block font-display text-title text-ink">{next.data.title}</span>
          </span>
          <span class="shrink-0 text-signal" aria-hidden="true">
            →
          </span>
        </a>
      </nav>
    )
  }
</Base>

---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getHeader } from '../../utils/headers';
import PageHeader from '../../components/PageHeader.astro';

const studies = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);

const header = getHeader('research');
---

<Base
  title="Research"
  description="The CANDY Lab's studies: TIGER, TIGER EARS, BRIDGE, BOBA/BOBAS, the Social Processing Task, WAVES, MICA and ENIGMA."
>
  <PageHeader
    image={header.image}
    imageAlt={header.alt}
    imageFocus="75% center"
    eyebrow="Research"
    title="Research"
    lede="Multimodal imaging, blood-based markers of immune function, and passive sensing from phones and wearables — used together to understand adolescent depression."
  />

  <section class="mx-auto max-w-[104rem] px-(--spacing-gutter) py-(--spacing-section)">
    <ul class="grid gap-px border border-ink/10 bg-ink/10 md:grid-cols-2 xl:grid-cols-3">
      {
        studies.map((study, i) => (
          <li class="reveal bg-paper-raised" data-reveal-delay={String(i * 60)}>
            <a href={`/research/${study.id}`} class="group flex h-full flex-col">
              {study.data.hero && (
                <div class="aspect-[3/2] overflow-hidden border-b border-ink/10 bg-paper">
                  {/* The card's own heading names the study, so the picture is
                      decorative here — alt text would make a screen reader
                      announce the same thing twice. */}
                  <Image
                    src={study.data.hero}
                    alt=""
                    widths={[400, 640, 900]}
                    sizes="(min-width: 1280px) 30vw, (min-width: 768px) 46vw, 92vw"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    class:list={[
                      'h-full w-full transition-transform duration-[1100ms] ease-[var(--ease-out-soft)] group-hover:scale-[1.03]',
                      // Several of these are small logos and figures. Contain
                      // rather than cover, so nothing is displayed above its
                      // native resolution or cropped into meaninglessness.
                      study.data.hero.width < 700 ? 'object-contain p-8' : 'object-cover',
                    ]}
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-7">
                {study.data.status && (
                  <span class="mb-3 self-start border border-signal/40 px-2 py-0.5 text-[0.62rem] font-medium uppercase tracking-[0.12em] text-signal">
                    {study.data.status}
                  </span>
                )}
                <h2 class="font-display text-[1.3rem] leading-snug text-ink transition-colors duration-400 group-hover:text-signal">
                  {study.data.title}
                </h2>
                <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-muted">
                  {study.data.summary}
                </p>
                <span class="mt-5 text-[0.9rem] text-signal" aria-hidden="true">
                  Read more →
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

---
import { site } from '../config';
import { getNavItems } from '../utils/pages';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const path = Astro.url.pathname;

// The fixed sections plus any page she created and left in the menu.
const nav = await getNavItems();

const isActive = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href + '/'));
---

{/* The header carries no background of its own. It earns a blurred ground and a
    hairline once the page has scrolled beneath it (`data-scrolled`, set in
    enhance.ts) — so at rest it sits on the page rather than in a bar, and in
    motion it stays legible over whatever is passing under it.

    Deliberately no height change on scroll: on interior pages it sits in the
    flow, and animating its padding would drag the page up under the reader. */}
<header
  class:list={[
    'site-header z-50 w-full',
    transparent ? 'fixed top-0 left-0' : 'sticky top-0',
  ]}
>
  <div
    class="mx-auto flex max-w-[104rem] items-center justify-between gap-6 px-(--spacing-gutter) py-5 md:py-6"
  >
    <a
      href="/"
      class="group flex items-baseline gap-3 leading-none focus-visible:outline-offset-8"
      aria-label={`${site.labNameShort} — home`}
    >
      <span
        class="font-display text-[1.5rem] tracking-[-0.02em] text-ink transition-colors duration-500 group-hover:text-signal md:text-[1.7rem]"
      >
        CANDY Lab
      </span>
      <span class="hidden text-eyebrow font-medium uppercase text-ink-muted lg:inline">
        UCLA
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative text-[0.94rem] tracking-wide transition-colors duration-300 hover:text-ink',
                  'after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-signal after:transition-all after:duration-500',
                  isActive(item.href)
                    ? 'text-ink after:w-full'
                    : 'text-ink-dim after:w-0 hover:after:w-full',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Small screens: a details/summary disclosure. Works with zero JS. -->
    <details class="group relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 text-eyebrow font-medium uppercase text-ink-dim [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
        <svg
          width="18"
          height="12"
          viewBox="0 0 18 12"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-300 group-open:rotate-90"
        >
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </summary>
      <nav
        aria-label="Primary"
        class="nav-panel absolute right-0 z-50 mt-5 w-60 border border-ink/10 bg-paper-raised p-2 shadow-xl"
      >
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block px-4 py-3 text-[0.95rem] transition-colors hover:bg-paper hover:text-ink',
                    isActive(item.href) ? 'text-signal' : 'text-ink-dim',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

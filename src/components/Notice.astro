---
/**
 * A visible, unmissable "content is missing" panel. Used wherever the brief
 * promised copy that was not supplied, so the gap is obvious to the client on
 * review rather than being papered over with invented text.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="max-w-(--container-prose) border-l-2 border-signal bg-signal/[0.07] px-7 py-6">
  <p class="text-eyebrow font-medium uppercase text-signal">{title}</p>
  <div class="mt-4 space-y-3 text-[1rem] leading-relaxed text-ink-dim">
    <slot />
  </div>
</div>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { splitWords } from '../utils/splitWords';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Optional image beside the title. */
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, lede, image, imageAlt } = Astro.props;

// Wrappers only — the heading text is untouched. See utils/splitWords.ts.
const titleHtml = splitWords(title);

// Several of the study images are small logos and figures (the smallest is
// 255px wide). On a light ground they can sit in a card at their own size
// rather than being stretched across a hero — nothing here is ever displayed
// above its native resolution.
const isSmall = image ? image.width < 700 : false;
---

<header class="border-b border-ink/10 bg-paper-raised">
  <div
    class:list={[
      'mx-auto grid max-w-[104rem] gap-12 px-(--spacing-gutter) pb-16 pt-16 md:pb-20 md:pt-24',
      image ? 'lg:grid-cols-[1.35fr_1fr] lg:items-center lg:gap-20' : '',
    ]}
  >
    <div>
      <p class="reveal text-eyebrow font-medium uppercase text-signal">{eyebrow}</p>
      <h1
        class="reveal-words mt-6 max-w-[20ch] font-display text-display text-ink"
        data-reveal-delay="100"
        set:html={titleHtml}
      />
      {
        lede && (
          <p
            class="reveal mt-7 max-w-(--container-prose) text-lede text-ink-dim"
            data-reveal-delay="340"
          >
            {lede}
          </p>
        )
      }
    </div>

    {
      image && (
        <figure
          class:list={[
            'reveal-media overflow-hidden border border-ink/10 bg-paper',
            isSmall ? 'flex items-center justify-center p-10' : '',
          ]}
          data-reveal-delay="220"
        >
          {/* The heading beside it already names the study, so the picture adds
              nothing a screen reader needs to hear twice — unless the client has
              written a real description, in which case that wins.

              This comment sits OUTSIDE the tag deliberately: a block comment
              placed between attributes is parsed as attributes, and each of its
              words ships as a junk boolean attribute. It also swallows the
              `alt` that follows it. */}
          <Image
            src={image}
            alt={imageAlt || ''}
            widths={isSmall ? [image.width] : [480, 800, 1200]}
            sizes={isSmall ? `${image.width}px` : '(min-width: 1024px) 40vw, 92vw'}
            loading="eager"
            fetchpriority="high"
            class:list={[
              isSmall ? 'h-auto w-auto max-w-full' : 'h-full w-full object-cover',
            ]}
          />
        </figure>
      )
    }
  </div>
</header>

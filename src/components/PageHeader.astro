---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { splitWords } from '../utils/splitWords';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Optional image. Bled off the page edge, or panelled if it is small. */
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * CSS object-position for the bleed crop — the image's focal point.
   * A portrait photograph in this wide header is cropped hard vertically, and
   * the default centre crop beheads a standing subject; "center 22%" keeps a
   * face in frame. Editable per page from the admin.
   */
  imageFocus?: string;
  /**
   * Force the bounded-panel treatment for a full-size photograph.
   * The bleed dissolves an image into the page with a wash of the page's own
   * white — correct for photographs on pale grounds, and a milky mistake on a
   * coloured one. A photograph with its own strong ground (the pink News
   * image) belongs in a box instead: the client's rule is that an image may
   * differ from the background when it sits in a deliberate panel.
   */
  imagePanel?: boolean;
}
const { eyebrow, title, lede, image, imageAlt, imageFocus, imagePanel = false } = Astro.props;

// Wrappers only — the heading text is untouched. See utils/splitWords.ts.
const titleHtml = splitWords(title);

// Two honest treatments rather than one compromise.
//
// A photograph is bled off the edge of the viewport and dissolved into the page
// along the edge that faces the type, so it reads as part of the page. A framed
// rectangle floating in a gutter of white reads as a stock image someone
// pasted in — which is exactly what it looks like.
//
// A small image is a different object: several of the study images are logos,
// the smallest 255px wide. Those get a panel and sit at their own size. Bleeding
// a logo across half the screen would mean upscaling it into mush.
const isSmall = image ? image.width < 700 : false;
const panel = Boolean(image) && (isSmall || imagePanel);
const bleed = Boolean(image) && !panel;
---

<header class="page-header relative overflow-hidden bg-paper-raised">
  <div
    class:list={[
      'mx-auto max-w-[104rem] px-(--spacing-gutter) pt-16 md:pt-24',
      bleed ? 'pb-16 md:pb-24' : 'pb-16 md:pb-20',
      panel ? 'lg:grid lg:grid-cols-[1.35fr_1fr] lg:items-center lg:gap-20' : '',
    ]}
  >
    {/* No image: the type is centred. Left-set type exists to sit against a
        picture; with nothing on the right it reads as a mistake — half a
        layout. Centred, the page opens like a title page instead. */}
    <div
      class:list={[
        'relative z-10',
        bleed ? 'lg:max-w-[56%]' : '',
        !image ? 'flex flex-col items-center text-center' : '',
      ]}
    >
      <p class="reveal text-eyebrow font-medium uppercase text-signal">{eyebrow}</p>
      <h1
        class="reveal-words mt-6 max-w-[20ch] font-display text-display text-ink"
        data-reveal-delay="100"
        set:html={titleHtml}
      />
      {
        lede && (
          <p
            class="reveal mt-7 max-w-(--container-prose) text-lede text-ink-dim"
            data-reveal-delay="340"
          >
            {lede}
          </p>
        )
      }
    </div>

    {
      panel && image && (
        <figure
          class:list={[
            'reveal-media mt-12 border border-ink/10 bg-paper lg:mt-0',
            isSmall ? 'flex items-center justify-center p-10' : 'overflow-hidden',
          ]}
          data-reveal-delay="220"
        >
          <Image
            src={image}
            alt={imageAlt || ''}
            widths={isSmall ? [image.width] : [480, 800, Math.min(image.width, 1400)]}
            sizes={isSmall ? `${image.width}px` : '(min-width: 1024px) 40vw, 92vw'}
            loading="eager"
            class:list={[isSmall ? 'h-auto w-auto max-w-full' : 'aspect-[3/2] h-auto w-full object-cover']}
            style={!isSmall && imageFocus ? `object-position: ${imageFocus}` : undefined}
          />
        </figure>
      )
    }
  </div>

  {
    bleed && image && (
      <div
        class="reveal-media page-header-media relative -mt-4 h-[34vh] overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:m-0 lg:h-auto lg:w-[48%]"
        data-reveal-delay="220"
      >
        {/* The heading beside it already names the page, so an atmospheric
            picture adds nothing a screen reader needs to hear twice — unless
            the client has written a real description, in which case it wins.

            Comment outside the tag: a block comment between attributes is
            parsed AS attributes and swallows the one after it. */}
        <Image
          src={image}
          alt={imageAlt || ''}
          widths={[480, 800, Math.min(image.width, 1400)]}
          sizes="(min-width: 1024px) 48vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
          style={imageFocus ? `object-position: ${imageFocus}` : undefined}
        />
        <div class="page-header-fade absolute inset-0" />
      </div>
    )
  }
</header>

<style>
  /* The dissolve is a wash of the PAGE's colour over the picture, never a
     colour sampled from it — so it stays correct for whatever the client
     uploads next rather than matching one file and seaming on every other.

     Phone: the picture sits under the type, so it is feathered along its top
     edge and emerges from the text. */
  .page-header-fade {
    background-image: linear-gradient(
      to bottom,
      var(--color-paper-raised) 0%,
      rgb(11 17 24 / 0.5) 12%,
      transparent 38%
    );
  }

  @media (min-width: 1024px) {
    /* Wide: a column bled off the right edge, dissolved on the left where it
       faces the heading, and softened top and bottom where it meets the
       navigation above and the section below. */
    .page-header-fade {
      background-image:
        linear-gradient(
          to right,
          var(--color-paper-raised) 0%,
          rgb(11 17 24 / 0.84) 14%,
          rgb(11 17 24 / 0.3) 34%,
          transparent 58%
        ),
        linear-gradient(
          to bottom,
          rgb(11 17 24 / 0.7) 0%,
          transparent 18%,
          transparent 80%,
          rgb(11 17 24 / 0.8) 100%
        );
    }
  }
</style>
